# Copy to .env and edit. Nothing here is read until the app restarts.

# --- Where the app runs ------------------------------------------------------
PORT=3000
# The address partner sites and payment redirects point back to.
# In production this must be the real https:// address, e.g. https://shop.danishhawk.com
PUBLIC_URL=http://localhost:3000

# --- Your login --------------------------------------------------------------
ADMIN_EMAIL=stefanhoegh@live.dk
# Change this before the app is reachable from the internet.
ADMIN_PASSWORD=skift-mig-nu
# Any long random string. Changing it signs everyone out.
SESSION_SECRET=change-me-to-something-long-and-random

# --- Commerce ----------------------------------------------------------------
BASE_CURRENCY=DKK
VAT_RATE=0.25
DEFAULT_COMMISSION_RATE=0.15
DEFAULT_DEPOSIT_PCT=0.5

# --- Card payments (optional) ------------------------------------------------
# Without these the app takes orders and invoices the deposit instead.
# Get them from dashboard.stripe.com. The webhook points at:
#   https://your-domain/webhooks/stripe   (event: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional) --------------------------------------------------------
# Without this, mail is written to the in-app outbox and nothing is sent.
# Point it at any service that accepts {from, to, subject, text} as JSON.
MAIL_FROM=Danish Hawk <stefanhoegh@live.dk>
MAIL_WEBHOOK_URL=

# --- Behind a reverse proxy with TLS -----------------------------------------
NODE_ENV=production
SECURE_COOKIES=true
